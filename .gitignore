*.zip

# Raw numpy data
*.npz
*.npy

# Generated predictions (reproducible via translate.py / retrieval_baseline.py)
translation/
retrieval/vectors.npz

# Logs
*.log
nohup.out

# Env / bytecode / OS
.venv312/
__pycache__/
.DS_Store
